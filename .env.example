ENVIRONMENT=
PORT=

# Azure OpenAI (chat). Blank = mock mode (no key needed, runs offline).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Document Intelligence (OCR). Blank = OCR off; scans still stored, flagged unreadable.
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
NOVA_CCU_OCR=

# Entra / auth. Blank = dev-fallback identity (X-User-Principal header), local only.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
SESSION_SECRET_KEY=
NOVA_CCU_TRUST_EASYAUTH=

# Comma-separated principals bootstrapped into these roles on first sight.
NOVA_CCU_ADMINS=
NOVA_CCU_SUPERVISORS=

# Persistent data directory in production.
NOVA_CCU_DATA_DIR=

# SMTP. Blank = record-and-download mode; nothing silently fails to send.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=

# Central audit forwarding. Blank = outbox stays local-only.
AUDIT_SINK_URL=
AUDIT_SOURCE_ID=
AUDIT_SOURCE_KEY=
