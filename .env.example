ENVIRONMENT=
PORT=

# Anthropic (chat). Blank = mock mode (no key needed, runs offline).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Document Intelligence (OCR). Blank = OCR off; scans still stored, flagged unreadable.
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
NOVA_CCU_OCR=

# Entra / auth. Blank = dev-fallback identity (X-User-Principal header), local only.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
SESSION_SECRET_KEY=
NOVA_CCU_TRUST_EASYAUTH=

# Shared front-door gate (optional). Blank = off, app is reachable directly.
# Not real per-user auth -- a coarse HTTP Basic Auth challenge in front of
# the whole app, for a semi-public deployment shared with a few people.
NOVA_CCU_SITE_USERNAME=
NOVA_CCU_SITE_PASSWORD=

# Comma-separated principals bootstrapped into these roles on first sight.
NOVA_CCU_ADMINS=
NOVA_CCU_SUPERVISORS=

# Persistent data directory in production.
NOVA_CCU_DATA_DIR=

# SMTP. Blank = record-and-download mode; nothing silently fails to send.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=

# Central audit forwarding. Blank = outbox stays local-only.
AUDIT_SINK_URL=
AUDIT_SOURCE_ID=
AUDIT_SOURCE_KEY=
